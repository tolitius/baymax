{:paths ["src" "resources"]

 :deps {tolitius/yang {:mvn/version "0.1.50"}
        org.babashka/sci {:mvn/version "0.9.45"}
        mount/mount {:mvn/version "0.1.21"}
        tolitius/mount-up {:mvn/version "0.1.3"}
        cprop/cprop {:mvn/version "0.1.20"}
        seancorfield/next.jdbc {:mvn/version "1.2.659"}
        org.postgresql/postgresql {:mvn/version "42.7.5"}
        hikari-cp/hikari-cp {:mvn/version "3.2.0"}
        org.mongodb/mongodb-driver-sync {:mvn/version "5.11.1"}
        clj-http/clj-http {:mvn/version "3.13.0"}
        metosin/jsonista {:mvn/version "0.3.13"}
        camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}

        org.clojure/tools.logging {:mvn/version "1.1.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.5.18"}

        metosin/reitit {:mvn/version "0.7.2"}
        ring/ring-jetty-adapter {:mvn/version "1.13.1"}
        ring/ring-core {:mvn/version "1.13.1"}

        io.prometheus/simpleclient {:mvn/version "0.16.0"}
        io.prometheus/simpleclient_common {:mvn/version "0.16.0"}

        nrepl/nrepl {:mvn/version "1.3.1"}}

 :aliases {:dev {:extra-paths ["dev" "dev/resources"]
                 :extra-deps {}}

           :repl {:extra-paths ["test" "test/resources"]
                  :extra-deps {nrepl/nrepl {:mvn/version "0.7.0"}
                               cider/cider-nrepl {:mvn/version "0.22.4"}
                               com.bhauman/rebel-readline {:mvn/version "0.1.4"}}
                  :main-opts ["-e" "(require 'dev)(in-ns 'dev)"
                              "-m" "nrepl.cmdline"
                              "--middleware" "[cider.nrepl/cider-middleware]"
                              "-i" "-f" "rebel-readline.main/-main"]}

           :test {:extra-paths ["test" "test/resources"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/url "https://github.com/cognitect-labs/test-runner.git"
                                                                     :sha "e7660458ce25bc4acb4ccc3e2415aae0a4907198"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}

           :outdated {:extra-deps {olical/depot {:mvn/version "2.0.1"}}
                      :main-opts ["-m" "depot.outdated.main" "-a" "outdated"]}

           :tag {:extra-deps {tolitius/tag {:mvn/version "0.1.15-SNAPSHOT"}}
                 :main-opts ["-m" "tag.core" "tolitius/baymax"
                             "baymax: your visibility and insights loyal companion"]}

           ;; ## build
           ;; rm -rf target; mkdir target; clojure -X:uberjar :jar target/baymax-standalone.jar :main-class baymax.app

           ;; ## run
           ;; export SOURCES__SOME_DB__CONNECTION__HOST=...
           ;; export SOURCES__SOME_DB__CONNECTION__PORT=...
           ;; export SOURCES__SOME_DB__CONNECTION__DATABASE=...
           ;; export SOURCES__SOME_DB__CONNECTION__USER=...
           ;; export SOURCES__SOME_DB__CONNECTION__PASSWORD=...
           ;;    ...
           ;; java -Dconf=<path to config.edn> -jar target/baymax-standalone.jar
           :uberjar {:replace-deps {com.github.seancorfield/depstar {:mvn/version "2.1.303"}}
                     :exec-fn hf.depstar/uberjar
                     :exec-args {:aot true}}

           :deploy {:extra-deps {deps-deploy/deps-deploy {:mvn/version "RELEASE"}}
                    :main-opts ["-m" "deps-deploy.deps-deploy" "deploy" "target/baymax.jar"]}

           :install {:extra-deps {deps-deploy/deps-deploy {:mvn/version "RELEASE"}}
                     :main-opts ["-m" "deps-deploy.deps-deploy" "install" "target/baymax.jar"]}}}
