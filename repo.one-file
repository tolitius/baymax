{:sources
 {:main-db
  {:type :postgres
   :connection {:host "dev.rds.multipass.comcast.com"
                :port 5432
                :database "multipass"
                :user "financier"
                :password "eMEg8DdfgvcIYJLP"}
   :pool {:maximum-pool-size 10
          :minimum-idle 2}
   :trusted true}}

 :collectors
 [
  {:id "invoice-counts"
   :source :main-db
   :schedule "1m"
   :query "select i.status, i.cifa_status, count(*)
           from financier.invoice i
           where i.cifa_status in ('P2 HOLD VALIDATED', 'HOLD VALIDATED', 'P2 HOLD NOT VALIDATED')
             and i.status in ('Approved', 'Rejected')
           group by i.status, i.cifa_status;"
   :transform "(fn [rows]
                 (mapv (fn [{:keys [status cifa-status count]}]
                         (let [status (clojure.string/lower-case status)
                               cifa-status (-> cifa-status clojure.string/lower-case (clojure.string/replace #\" \" \"_\"))]
                           {:name (str \"status.\" status \".\" cifa-status)
                            :value count
                            :labels {:status status
                                     :cifa-status cifa-status
                                     :app \"financier\"}}))
                       rows))"}]


 :publishers
 [
  {:type :prometheus
   :port 9090
   :endpoint "/metrics"
   :collectors ["invoice-counts"]}

  {:type :stdout
   :pretty-print true
   :collectors ["invoice-counts"]}
  ]

 :scheduler
 {:default-interval "1m"
  :thread-pool-size 5}

 :web
 {:port 4242
  :auth {:user "admin"
         :password "foobar"}}

 :logging
 {:level :info
  :appenders [{:type :console}
              {:type :file
               :filename "/var/log/baymax/baymax.log"
               :rolling true}]}}

