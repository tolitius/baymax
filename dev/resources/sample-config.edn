{:sources
 {:main-db
  {:type :postgres
   :connection {:host "db.example.com"
                :port 5432
                :database "production"
                :user "metrics_user"
                :password "foobar"}
   :pool {:maximum-pool-size 10
          :minimum-idle 2}
   :trusted true}

  :analytics-db
  {:type :postgres
   :connection {:host "analytics.example.com"
                :port 5432
                :database "analytics"
                :user "readonly"
                :password-env "ANALYTICS_PASSWORD"}
   :trusted true}

  :app-api
  {:type :http
   :base-url "https://api.example.com"
   :headers {"Authorization" "Bearer ${API_TOKEN}"}
   :trusted true}

  :app-jmx
  {:type :jmx
   :connection {:host "app1.example.com"
                :port 1099}
   :trusted true}}

 :collectors
 [
  ;; account metrics from main DB

  {:id "account-metrics"
   :source :main-db
   :schedule "1m"
   :query "select i.status, i.amount_type, count(*) as count
           from abc.account i
           where i.amount_type in ('TYPE_A', 'TYPE_B', 'TYPE_C')
             and i.status in ('ACTIVE', 'PENDING', 'CLOSED')
           group by i.status, i.amount_type"
   :transform "(fn [rows]
                 (mapv (fn [{:keys [status amount_type count]}]
                         {:name (str \"accounts.\" status \".\" amount_type)
                          :value count
                          :labels {:status status
                                   :amount_type amount_type
                                   :service \"accounts-api\"}})
                       rows))"}

  ;; transaction metrics from main db

  {:id "transaction-metrics"
   :source :main-db
   :schedule "5m"
   :query "select transaction_type,
                  count(*) as total,
                  avg(amount) as avg_amount,
                  sum(amount) as sum_amount
           from transactions
           where created_at > now() - interval '1 day'
           group by transaction_type"
   :transform "(fn [rows]
                 (mapcat (fn [{:keys [transaction_type total avg_amount sum_amount]}]
                           [{:name \"transactions.count\"
                             :value total
                             :labels {:type transaction_type}}
                            {:name \"transactions.avg_amount\"
                             :value avg_amount
                             :labels {:type transaction_type}}
                            {:name \"transactions.total_amount\"
                             :value sum_amount
                             :labels {:type transaction_type}}])
                         rows))"}

  ;; user activity metrics from analytics DB

  {:id "user-activity"
   :source :analytics-db
   :schedule "15m"
   :query "select country, device_type, count(distinct user_id) as active_users
           from user_sessions
           where session_start > now() - interval '1 hour'
           group by country, device_type"
   :transform "(fn [rows]
                 (mapv (fn [{:keys [country device_type active_users]}]
                         {:name \"active_users\"
                          :value active_users
                          :labels {:country country
                                   :device device_type}})
                       rows))"}

  ;; api health check

  {:id "api-health"
   :source :app-api
   :schedule "30s"
   :path "/health"
   :method "GET"
   :transform "(fn [response]
                 (let [status (:status response)
                       body (:body response)
                       healthy (= status 200)]
                   [{:name \"api.healthy\"
                     :value (if healthy 1 0)
                     :labels {:service \"main-api\"}}
                    {:name \"api.response_time\"
                     :value (get-in body [:metrics :response_time] 0)
                     :labels {:service \"main-api\"}}]))"}

  ;; jvm metrics via jmx

  {:id "jvm-metrics"
   :source :app-jmx
   :schedule "1m"
   :beans [["java.lang:type=Memory" "HeapMemoryUsage"]
           ["java.lang:type=Threading" "ThreadCount"]
           ["java.lang:type=OperatingSystem" "ProcessCpuLoad"]]
   :transform "(fn [results]
                 (map (fn [[bean attr value]]
                        (let [bean-name (last (clojure.string/split bean #\"=\"))
                              metric-name (str \"jvm.\"
                                               (-> bean-name
                                                   (clojure.string/lower-case)
                                                   (clojure.string/replace #\"[^a-z0-9]\" \"_\"))
                                               \".\"
                                               (-> attr
                                                   (clojure.string/lower-case)
                                                   (clojure.string/replace #\"[^a-z0-9]\" \"_\")))]
                          {:name metric-name
                           :value (if (map? value)
                                    (get value :used 0)
                                    value)
                           :labels {:service \"app1\"}}))
                      results))"}]


 :publishers
 [{:type :prometheus
   :port 9090
   :endpoint "/metrics"
   :collectors ["account-metrics"
                "transaction-metrics"
                "user-activity"
                "api-health"
                "jvm-metrics"]}

  {:type :influxdb
   :url "https://influx.example.com"
   :token-env "INFLUX_TOKEN"
   :org "example-org"
   :bucket "metrics"
   :collectors ["account-metrics"
                "transaction-metrics"]}]

 :scheduler
 {:default-interval "1m"
  :thread-pool-size 5}

 :web
 {:port 4242
  :root-uri "/"} ;; just for show. it would be "/" be default

 :logging
 {:level :info
  :appenders [{:type :console}
              {:type :file
               :filename "/var/log/baymax/baymax.log"
               :rolling true}]}}
